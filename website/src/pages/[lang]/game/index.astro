---
import Base from '../../../layouts/Base.astro';
import { t, langs, otherLang, type Lang } from '../../../i18n';
import { groupPhoto } from '../../../lib/content';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const s = t(lang);
---

<Base
  lang={lang}
  title={`${s.game.title} · ${s.siteName}`}
  description={s.game.sub}
  altPath={`/${otherLang(lang)}/game/`}
  image={groupPhoto}
  imageAlt={s.hero.alt}
  bare
>
  <section class="game-page">
    {/* The page has no visible chrome, but it still needs a heading for screen
        readers, for search, and for the build's one-h1-per-page check. */}
    <h1 class="sr-only">{s.game.title}</h1>

    <div class="stage" id="stage">
      <canvas id="game" aria-label={s.game.title}></canvas>

      <div class="topbar">
        <a class="back" href={`/${lang}/`} aria-label={s.backHome}>
          &#8592; {s.siteName}
        </a>
        <button type="button" id="full" class="icon" aria-label="Fullscreen">
          &#9974;
        </button>
      </div>

      <div class="hud" id="hud">
        <div class="score" id="score" aria-live="off">
          0
        </div>
        <p class="start" id="start">
          {s.game.tapToStart}
        </p>
      </div>

      <div class="board" id="board" hidden>
        <h2>{s.game.leaderboard}</h2>
        <p class="mine" id="mine"></p>
        <ol class="list" id="list"></ol>
        <form id="submit-form" autocomplete="off">
          <input
            type="text"
            id="who"
            maxlength="16"
            placeholder={s.game.namePlaceholder}
            aria-label={s.game.namePlaceholder}
          />
          <button type="submit" id="send">
            {s.game.submit}
          </button>
        </form>
        <button type="button" id="again" class="again">
          {s.game.again}
        </button>
      </div>
    </div>
  </section>
</Base>

<script>
  import { Game } from '../../../game/engine';

  const stage = document.getElementById('stage') as HTMLDivElement;
  const canvas = document.getElementById('game') as HTMLCanvasElement;
  const hud = document.getElementById('hud') as HTMLDivElement;
  const scoreEl = document.getElementById('score') as HTMLDivElement;
  const startEl = document.getElementById('start') as HTMLParagraphElement;
  const board = document.getElementById('board') as HTMLDivElement;
  const listEl = document.getElementById('list') as HTMLOListElement;
  const mineEl = document.getElementById('mine') as HTMLParagraphElement;
  const whoEl = document.getElementById('who') as HTMLInputElement;
  const sendEl = document.getElementById('send') as HTMLButtonElement;
  const formEl = document.getElementById('submit-form') as HTMLFormElement;
  const againEl = document.getElementById('again') as HTMLButtonElement;

  const S = (
    document.documentElement.lang === 'en'
      ? {
          submit: 'Submit',
          submitting: 'Submitting…',
          submitted: 'Submitted',
          retry: 'Retry',
          empty: 'Nobody on the board yet.',
          offline: 'The leaderboard is unreachable; this run stays on your device.',
          run: 'This run',
          rank: 'Rank',
        }
      : {
          submit: '记入',
          submitting: '提交中…',
          submitted: '已记入',
          retry: '重试',
          empty: '还没有人上榜。',
          offline: '排行榜暂时连不上，本局成绩只留在本机。',
          run: '本局',
          rank: '第',
        }
  ) as Record<string, string>;

  const esc = (v: string) =>
    v.replace(
      /[&<>"']/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string,
    );

  // trailingSlash is 'always', so '/api/scores' 404s and a POST that followed a
  // redirect would arrive without its body. Always use the exact path.
  const SCORES_API = '/api/scores/';

  let pending: { score: number; durationMs: number } | null = null;
  // onGameOver fires when the dog is hit; the board only opens once it lands.
  // Hold the run length until then so the submission carries a real duration.
  let lastRunMs = 0;

  function renderBoard(top: { rank: number; name: string; score: number }[], mine: number | null) {
    if (!top.length) {
      listEl.innerHTML = `<li class="empty">${esc(S.empty)}</li>`;
      return;
    }
    listEl.innerHTML = top
      .map(
        (r) =>
          `<li class="${r.rank === mine ? 'me' : ''}"><span class="n">${r.rank}</span>` +
          `<span class="who">${esc(r.name)}</span><span class="s">${r.score}</span></li>`,
      )
      .join('');
  }

  async function loadBoard(mine: number | null) {
    try {
      const r = await fetch(SCORES_API);
      if (!r.ok) throw new Error(String(r.status));
      renderBoard((await r.json()).top, mine);
    } catch {
      listEl.innerHTML = `<li class="empty">${esc(S.offline)}</li>`;
    }
  }

  function openBoard(score: number, durationMs: number) {
    pending = { score, durationMs };
    mineEl.textContent = `${S.run} ${score}`;
    whoEl.value = localStorage.getItem('haide-name') ?? '';
    whoEl.disabled = false;
    sendEl.disabled = false;
    sendEl.textContent = S.submit;
    board.hidden = false;
    loadBoard(null);
  }

  const game = new Game(canvas, '/game/', {
    onScore: (n) => {
      scoreEl.textContent = String(n);
    },
    onGameOver: (score, durationMs) => {
      lastRunMs = durationMs;
      const best = Math.max(score, Number(localStorage.getItem('haide-best') ?? 0));
      localStorage.setItem('haide-best', String(best));
    },
    onModeChange: (mode) => {
      startEl.hidden = mode !== 'ready';
      scoreEl.hidden = mode === 'ready';
      if (mode === 'ready') {
        scoreEl.textContent = '0';
        board.hidden = true;
      }
      if (mode === 'gameover') openBoard(game.score, lastRunMs);
    },
  });

  function fit() {
    const r = stage.getBoundingClientRect();
    game.resize(r.width, r.height, Math.min(window.devicePixelRatio || 1, 3));
  }

  formEl.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!pending) return;
    const name = whoEl.value.trim();
    if (!name) {
      whoEl.focus();
      return;
    }
    const myScore = pending.score;
    localStorage.setItem('haide-name', name);
    sendEl.disabled = true;
    sendEl.textContent = S.submitting;
    try {
      const r = await fetch(SCORES_API, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ name, score: myScore, durationMs: Math.round(pending.durationMs) }),
      });
      const data = await r.json();
      if (!r.ok) throw new Error(data.error ?? String(r.status));
      pending = null;
      whoEl.disabled = true;
      sendEl.textContent = S.submitted;
      mineEl.textContent = data.yourRank
        ? `${S.run} ${myScore} · ${S.rank} ${data.yourRank}`
        : `${S.run} ${myScore}`;
      renderBoard(data.top, data.yourRank);
    } catch (err) {
      sendEl.disabled = false;
      sendEl.textContent = S.retry;
      mineEl.textContent = String((err as Error).message);
    }
  });

  againEl.addEventListener('click', (e) => {
    board.hidden = true;
    pending = null;
    game.reset();
    (e.currentTarget as HTMLButtonElement).blur();
  });

  // Input. Pointer events on the stage, Space on the document — but never while
  // the leaderboard is open or a field has focus.
  const tap = (e: Event) => {
    if (!board.hidden) return;
    e.preventDefault();
    game.flap();
  };
  stage.addEventListener('pointerdown', tap);
  addEventListener('keydown', (e) => {
    const el = e.target as HTMLElement | null;
    if (el && /^(INPUT|BUTTON|TEXTAREA|SELECT)$/.test(el.tagName)) return;
    if (e.code === 'Space' || e.key === ' ') {
      if (board.hidden) e.preventDefault();
      if (!board.hidden) return;
      game.flap();
    }
  });

  // A window resize listener is the wrong trigger: it can fire before the stage
  // has been laid out, and it misses the case where the box changes without the
  // window doing so. Watch the element itself.
  new ResizeObserver(fit).observe(stage);

  // Moving the window to a display with a different pixel ratio changes how big
  // the backing store needs to be, and that fires no resize event.
  let dprQuery: MediaQueryList | null = null;
  const watchDpr = () => {
    dprQuery?.removeEventListener('change', onDpr);
    dprQuery = matchMedia(`(resolution: ${window.devicePixelRatio}dppx)`);
    dprQuery.addEventListener('change', onDpr);
  };
  const onDpr = () => {
    fit();
    watchDpr();
  };
  watchDpr();

  addEventListener('orientationchange', () => setTimeout(fit, 150));
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') game.resume();
  });

  // Real fullscreen where the browser allows it (desktop, Android). iOS Safari
  // does not implement it for non-video elements, so hide the button there
  // rather than offer one that does nothing.
  const fullEl = document.getElementById('full') as HTMLButtonElement;
  const root = document.documentElement;
  if (!root.requestFullscreen) {
    fullEl.hidden = true;
  } else {
    fullEl.addEventListener('click', async (e) => {
      (e.currentTarget as HTMLButtonElement).blur();
      try {
        if (document.fullscreenElement) await document.exitFullscreen();
        else await root.requestFullscreen({ navigationUI: 'hide' });
      } catch {
        /* user gesture rejected or not permitted; nothing to recover */
      }
    });
  }

  game
    .load()
    .then(() => {
      fit();
      game.start();
    })
    .catch((err) => {
      hud.innerHTML = `<p class="start">${esc(String(err))}</p>`;
    });
</script>

<style>
  /*
   * Full-viewport game. The page itself no longer scrolls (Base's `bare` locks
   * the document), so a missed tap can no longer drag the page instead of
   * flapping. The stage fills whatever the viewport gives it and the engine
   * fits the play area inside, so there are still no magic numbers here.
   */
  .game-page {
    height: 100%;
    display: grid;
    place-items: center;
    background: #14110c;
  }
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    cursor: pointer;
  }
  canvas {
    display: block;
    background: #8fb4d4;
  }

  .topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: calc(0.5rem + env(safe-area-inset-top)) calc(0.7rem + env(safe-area-inset-right)) 0.5rem
      calc(0.7rem + env(safe-area-inset-left));
    pointer-events: none;
  }
  .topbar > * {
    pointer-events: auto;
  }
  .back,
  .icon {
    font: inherit;
    font-size: 0.85rem;
    line-height: 1;
    color: #fff;
    background: rgba(61, 42, 18, 0.5);
    border: 0;
    border-radius: 999px;
    padding: 0.42rem 0.75rem;
    text-decoration: none;
    cursor: pointer;
  }
  .back:hover,
  .icon:hover {
    background: rgba(61, 42, 18, 0.75);
  }
  .icon[hidden] {
    display: none;
  }

  .hud {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 0.6rem;
    padding-top: calc(3.2rem + env(safe-area-inset-top));
    pointer-events: none;
  }
  .score {
    font-size: clamp(2rem, 6vh, 3rem);
    font-weight: 700;
    color: #fff;
    text-shadow:
      0 2px 0 #3d2a12,
      0 0 6px rgba(61, 42, 18, 0.5);
    font-variant-numeric: tabular-nums;
  }
  .start {
    margin: 0;
    color: #fff;
    background: rgba(61, 42, 18, 0.55);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-size: 0.95rem;
  }

  .board {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: calc(1rem + env(safe-area-inset-top)) 1rem calc(1rem + env(safe-area-inset-bottom));
    background: rgba(20, 17, 12, 0.88);
    color: #e9dcc4;
    overflow: hidden;
    max-width: 30rem;
    margin-inline: auto;
  }
  .board[hidden] {
    display: none;
  }
  .board h2 {
    font-size: 1rem;
    margin: 0;
    letter-spacing: 0.06em;
  }
  .mine {
    margin: 0;
    color: #c9954a;
    font-size: 0.95rem;
  }
  .list {
    flex: 1 1 auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    margin: 0;
    padding: 0;
    list-style: none;
    font-variant-numeric: tabular-nums;
    font-size: 0.92rem;
    touch-action: pan-y;
  }
  .list :global(li) {
    display: grid;
    grid-template-columns: 2.2em 1fr auto;
    gap: 0.5rem;
    padding: 0.2rem 0.3rem;
    border-radius: 4px;
  }
  .list :global(li.me) {
    background: #3a3026;
    color: #c9954a;
  }
  .list :global(.n) {
    color: #a08f74;
  }
  .list :global(.s) {
    font-weight: 700;
  }
  .list :global(.empty) {
    color: #a08f74;
    display: block;
  }
  #submit-form {
    display: flex;
    gap: 0.4rem;
  }
  #who {
    flex: 1 1 auto;
    min-width: 0;
    font: inherit;
    color: #e9dcc4;
    background: #14110c;
    border: 1px solid #3a3026;
    border-radius: 5px;
    padding: 0.55rem 0.6rem;
  }
  #who:focus {
    outline: none;
    border-color: #c9954a;
  }
  .board button {
    font: inherit;
    color: #e9dcc4;
    background: #2b241a;
    border: 1px solid #3a3026;
    border-radius: 5px;
    padding: 0.55rem 0.8rem;
    cursor: pointer;
  }
  .board button:hover {
    border-color: #c9954a;
  }
  .again {
    width: 100%;
  }
</style>
