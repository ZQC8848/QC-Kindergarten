---
import Base from '../../layouts/Base.astro';
import GroupPhoto from '../../components/GroupPhoto.astro';
import CharacterCard from '../../components/CharacterCard.astro';
import StoryList from '../../components/StoryList.astro';
import Places from '../../components/Places.astro';
import { characters, groupPhoto } from '../../lib/content';
import { t, langs, otherLang, type Lang } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const s = t(lang);
---

<Base
  lang={lang}
  title={s.siteName}
  description={s.intro}
  altPath={`/${otherLang(lang)}/`}
  image={groupPhoto}
  imageAlt={s.hero.alt}
>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>{s.tagline}</h1>
      <p>{s.intro}</p>
    </div>
    <GroupPhoto lang={lang} />
  </section>

  <section id="characters" class="section wrap">
    <div class="section-head">
      <h2>{s.charactersTitle}</h2>
      <p>{s.charactersSub}</p>
    </div>
    <div class="grid">
      {characters.map((c, i) => (
        <CharacterCard c={c} lang={lang} index={i} />
      ))}
    </div>
  </section>

  <section id="stories" class="section band">
    <div class="wrap">
      <div class="section-head">
        <h2>{s.storiesTitle}</h2>
        <p>{s.storiesSub}</p>
      </div>
      <StoryList lang={lang} />
    </div>
  </section>

  <section id="places" class="section wrap">
    <div class="section-head">
      <h2>{s.placesTitle}</h2>
      <p>{s.placesSub}</p>
    </div>
    <Places lang={lang} />
  </section>

  <section id="game" class="section wrap">
    <a class="game-card" href={`/${lang}/game/`}>
      <div class="game-copy">
        <h2>{s.game.title}</h2>
        <p>{s.game.sub}</p>
        <span class="cta">{s.game.cardCta} →</span>
      </div>
      <img
        class="game-art"
        src="/game/haide-card.png"
        alt=""
        width="120"
        height="96"
        loading="lazy"
        decoding="async"
      />
    </a>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    display: grid;
    gap: 1.5rem;
  }
  .hero-copy h1 {
    max-width: 20ch;
    text-wrap: balance;
    white-space: pre-line;
  }
  .hero-copy p {
    max-width: 52ch;
    margin-top: 0.8rem;
    color: var(--ink-2);
    font-size: 1.05rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }
  .band {
    background: var(--panel);
  }

  /* Entry card. The sprite sheet is used as the art on purpose: four frames in a
     row reads as a filmstrip, and it is a file the page already ships. */
  .game-card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: clamp(1.1rem, 3vw, 1.8rem);
    border: 1px solid var(--line, rgba(0, 0, 0, 0.12));
    border-radius: 12px;
    background: linear-gradient(100deg, var(--panel), transparent 70%);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .game-card:hover {
    border-color: currentColor;
    transform: translateY(-2px);
  }
  .game-copy h2 {
    margin: 0;
  }
  .game-copy p {
    margin: 0.4rem 0 0;
    color: var(--ink-2);
    max-width: 44ch;
  }
  .cta {
    display: inline-block;
    margin-top: 0.8rem;
    font-weight: 600;
  }
  .game-art {
    height: 88px;
    width: auto;
    image-rendering: pixelated;
  }
  @media (max-width: 640px) {
    .game-card {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .game-art {
      height: 72px;
      justify-self: start;
    }
  }
</style>
